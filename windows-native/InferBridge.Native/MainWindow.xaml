<Window
    x:Class="InferBridge.Native.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="InferBridge">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <NavigationView x:Name="MainNavigation"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        OpenPaneLength="220"
                        SelectionChanged="MainNavigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Icon="Message" Content="Chat" Tag="chat" />
                <NavigationViewItem Icon="Library" Content="Model library" Tag="models" />
                <NavigationViewItem Icon="Home" Content="Engine" Tag="overview" />
            </NavigationView.MenuItems>
            <Grid Padding="24,12,24,20">
                <ScrollViewer x:Name="OverviewPanel" Visibility="Collapsed">
                    <StackPanel Spacing="16" MaxWidth="700" HorizontalAlignment="Left">
                        <TextBlock Text="Your local AI engine" FontSize="28"
                                   FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="Inference and model files stay in the existing Python/OpenVINO engine."
                                   TextWrapping="Wrap" Opacity="0.8" />
                        <InfoBar x:Name="ConnectionInfo" Title="Local engine"
                                 Severity="Informational" IsOpen="True"
                                 IsClosable="False" Message="Checking the local engine…" />
                        <ProgressRing x:Name="ConnectionProgress" Width="30" Height="30"
                                      IsActive="False" HorizontalAlignment="Left" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="RefreshButton" Content="Refresh status"
                                    Click="RefreshButton_Click" />
                            <Button x:Name="StartButton" Content="Start local engine"
                                    Click="StartButton_Click" />
                        </StackPanel>
                        <TextBlock x:Name="ConnectionDetails" TextWrapping="Wrap" Opacity="0.8" />
                        <TextBlock Text="API authentication" FontWeight="SemiBold" FontSize="18" />
                        <TextBlock Text="If your engine uses an API key, enter it for this window only. InferBridge never saves it or sends it to tray-control endpoints."
                                   TextWrapping="Wrap" Opacity="0.8" />
                        <PasswordBox x:Name="ApiKeyBox" Header="Engine API key"
                                     PlaceholderText="Optional bearer key"
                                     MaxLength="512" Width="360"
                                     HorizontalAlignment="Left" />
                        <Button Content="Connect with key" HorizontalAlignment="Left"
                                Click="RefreshButton_Click" />
                        <InfoBar Title="Native Windows"
                                 IsOpen="True" IsClosable="False"
                                 Severity="Informational"
                                 Message="This is a WinUI 3 client. It does not embed a web page or own a second inference engine." />
                    </StackPanel>
                </ScrollViewer>
                <Grid x:Name="ModelsPanel" Visibility="Collapsed" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="8">
                        <TextBlock Text="Model library" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock x:Name="ModelsSummary" TextWrapping="Wrap" />
                        <InfoBar x:Name="ModelsInfo" Title="Model library" IsOpen="False" IsClosable="True" />
                    </StackPanel>
                    <ListView x:Name="ModelsList" Grid.Row="1"
                              SelectionMode="Single"
                              SelectionChanged="ModelsList_SelectionChanged"
                              AutomationProperties.Name="Engine model inventory" />
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10">
                        <Button x:Name="DownloadButton" Content="Download and load" IsEnabled="False"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="DownloadButton_Click" />
                        <Button x:Name="LoadButton" Content="Load" IsEnabled="False"
                                Click="LoadButton_Click" />
                        <Button x:Name="UnloadButton" Content="Unload" IsEnabled="False"
                                Click="UnloadButton_Click" />
                        <Button Content="Refresh" Click="RefreshButton_Click"
                                AutomationProperties.Name="Refresh models" />
                    </StackPanel>
                </Grid>
                <Grid x:Name="ChatPanel" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="10">
                        <TextBlock Text="Chat" FontSize="28" FontWeight="SemiBold" />
                        <ComboBox x:Name="ChatModelPicker" Header="Loaded model"
                                  MinWidth="230" MaxWidth="460"
                                  HorizontalAlignment="Left"
                                  SelectionChanged="ChatModelPicker_SelectionChanged"
                                  AutomationProperties.Name="Select a loaded inference model" />
                        <InfoBar x:Name="ChatInfo" IsOpen="True" IsClosable="False"
                                 Severity="Informational" Title="Getting ready"
                                 Message="Connect to your engine and load a model to begin." />
                    </StackPanel>
                    <ListView x:Name="ChatHistory" Grid.Row="1"
                              SelectionMode="None"
                              AutomationProperties.Name="Conversation history" />
                    <StackPanel Grid.Row="2" Spacing="8">
                        <TextBox x:Name="PromptBox" Header="Message"
                                 PlaceholderText="Ask your local model…"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="88" MaxHeight="160" MaxLength="8000"
                                 AutomationProperties.Name="Chat prompt" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="SendButton" Content="Send" IsEnabled="False"
                                    Click="SendButton_Click">
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="Enter" Modifiers="Control" />
                                </Button.KeyboardAccelerators>
                            </Button>
                            <Button x:Name="CancelButton" Content="Cancel response"
                                    IsEnabled="False" Click="CancelButton_Click" />
                            <Button Content="New chat" Click="NewChatButton_Click" />
                            <ProgressRing x:Name="ChatProgress" IsActive="False"
                                          Width="24" Height="24" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
