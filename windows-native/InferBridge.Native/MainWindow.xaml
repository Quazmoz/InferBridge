<Window
    x:Class="InferBridge.Native.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="InferBridge">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <NavigationView x:Name="MainNavigation"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        OpenPaneLength="220"
                        SelectionChanged="MainNavigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Icon="Message" Content="Chat" Tag="chat" />
                <NavigationViewItem Icon="Library" Content="Model library" Tag="models" />
                <NavigationViewItem Icon="Find" Content="Hugging Face" Tag="huggingface" />
                <NavigationViewItem Icon="Home" Content="Engine" Tag="overview" />
                <NavigationViewItem Icon="Setting" Content="Operations &amp; diagnostics" Tag="operations" />
                <NavigationViewItem Icon="Repair" Content="System Doctor" Tag="doctor" />
                <NavigationViewItem Icon="Save" Content="Storage &amp; cache" Tag="storage" />
                <NavigationViewItem x:Name="SettingsNavigationItem" Icon="Setting" Content="Settings" Tag="settings" />
            </NavigationView.MenuItems>
            <Grid Padding="24,12,24,20">
                <ScrollViewer x:Name="OverviewPanel" Visibility="Collapsed">
                    <StackPanel Spacing="16" MaxWidth="700" HorizontalAlignment="Left">
                        <TextBlock Text="Your local AI engine" FontSize="28"
                                   FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="Inference and model files stay in the existing Python/OpenVINO engine."
                                   TextWrapping="Wrap" Opacity="0.8" />
                        <InfoBar x:Name="ConnectionInfo" Title="Local engine"
                                 Severity="Informational" IsOpen="True"
                                 IsClosable="False" Message="Checking the local engine…" />
                        <ProgressRing x:Name="ConnectionProgress" Width="30" Height="30"
                                      IsActive="False" HorizontalAlignment="Left" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="RefreshButton" Content="Refresh status"
                                    Click="RefreshButton_Click" />
                            <Button x:Name="StartButton" Content="Start local engine"
                                    Click="StartButton_Click" />
                        </StackPanel>
                        <TextBlock x:Name="ConnectionDetails" TextWrapping="Wrap" Opacity="0.8" />
                        <TextBlock Text="Hardware &amp; inference" FontWeight="SemiBold" FontSize="18" />
                        <TextBlock x:Name="HardwareSummary" Text="Connect to inspect available inference devices."
                                   TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        <Button x:Name="ScanHardwareButton" Content="Scan inference devices"
                                HorizontalAlignment="Left" Click="ScanHardwareButton_Click" />
                        <TextBlock Text="API authentication" FontWeight="SemiBold" FontSize="18" />
                        <TextBlock Text="If your engine uses an API key, enter it for this window only. InferBridge never saves it or sends it to tray-control endpoints."
                                   TextWrapping="Wrap" Opacity="0.8" />
                        <PasswordBox x:Name="ApiKeyBox" Header="Engine API key"
                                     PlaceholderText="Optional bearer key"
                                     MaxLength="512" Width="360"
                                     HorizontalAlignment="Left" />
                        <Button Content="Connect with key" HorizontalAlignment="Left"
                                Click="RefreshButton_Click" />
                        <InfoBar Title="Native Windows"
                                 IsOpen="True" IsClosable="False"
                                 Severity="Informational"
                                 Message="This is a WinUI 3 client. It does not embed a web page or own a second inference engine." />
                        <InfoBar x:Name="WebUiInfo" Title="Web GUI (optional)"
                                 Message="The browser interface is secondary. Open it only when needed."
                                 IsOpen="True" IsClosable="False" Severity="Informational">
                            <InfoBar.ActionButton>
                                <Button x:Name="WebUiButton" Content="Open web GUI" IsEnabled="False"
                                        Click="WebUiButton_Click" />
                            </InfoBar.ActionButton>
                        </InfoBar>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="DoctorPanel" Visibility="Collapsed">
                    <StackPanel MaxWidth="800" HorizontalAlignment="Left" Spacing="14">
                        <TextBlock Text="System Doctor" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Text="Run read-only checks using the same engine and device endpoints as the web GUI. Results reflect this machine, not a separate native inference engine."
                                   TextWrapping="Wrap" Opacity="0.8" />
                        <InfoBar x:Name="DoctorInfo" Title="System Doctor"
                                 IsOpen="True" IsClosable="False"
                                 Severity="Informational"
                                 Message="Select Run checks to inspect the local runtime." />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="DoctorRefreshButton" Content="Run checks again"
                                    Click="DoctorRefreshButton_Click" />
                            <Button x:Name="DoctorCopyButton" Content="Copy sanitized support report"
                                    IsEnabled="False" Click="DoctorCopyButton_Click" />
                            <ProgressRing x:Name="DoctorProgress" Width="26" Height="26"
                                          IsActive="False" />
                        </StackPanel>
                        <TextBlock x:Name="DoctorSummary" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite"
                                   IsTextSelectionEnabled="True"
                                   Text="Open System Doctor to inspect hardware and runtime readiness." />
                        <TextBlock Text="Detected OpenVINO devices" FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="DoctorDevices" TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True" Text="Not checked" />
                        <TextBlock Text="Model readiness" FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="DoctorModels" TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True" Text="Not checked" />
                        <TextBlock Text="Checks and recommended actions" FontSize="18"
                                   FontWeight="SemiBold" />
                        <ItemsControl x:Name="DoctorChecks"
                                      AutomationProperties.Name="System Doctor health checks" />
                        <TextBlock Text="The support report excludes credentials, prompts, chat content, model errors, and local file paths. Review copied text before sharing."
                                   TextWrapping="Wrap" Opacity="0.8" />
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="OperationsPanel" Visibility="Collapsed">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left" Spacing="16">
                        <TextBlock Text="Operations &amp; diagnostics" FontSize="28"
                                   FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="Native controls for the same local engine operations available in the web GUI."
                                   TextWrapping="Wrap" Opacity="0.8" />
                        <InfoBar x:Name="OperationsInfo" Title="Engine operations"
                                 IsOpen="True" IsClosable="False"
                                 Message="Open this page to inspect the current engine state."
                                 Severity="Informational" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="OperationsRefreshButton" Content="Refresh operations"
                                    Click="OperationsRefreshButton_Click" />
                            <ProgressRing x:Name="OperationsProgress" IsActive="False"
                                          Width="28" Height="28" />
                        </StackPanel>
                        <TextBlock Text="Engine &amp; installation" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="OperationsDetails" TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True"
                                   AutomationProperties.LiveSetting="Polite"
                                   Text="Connect to the local engine to view its status." />
                        <TextBlock Text="Hardware benchmarks" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="OperationsBenchmarks" TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True"
                                   Text="The engine has not reported benchmark status." />
                        <TextBlock Text="Quick benchmark runs one local measurement (32 generated tokens) on the currently loaded model and actual device. It may use significant CPU, GPU, NPU, memory and time. Mock results are synthetic." TextWrapping="Wrap" Opacity="0.8" />
                        <Button x:Name="QuickBenchmarkButton" Content="Run quick benchmark" IsEnabled="False"
                                HorizontalAlignment="Left" Click="QuickBenchmarkButton_Click" />
                        <TextBlock x:Name="BenchmarkRunResult" TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True"
                                   AutomationProperties.LiveSetting="Polite" />
                        <TextBlock Text="Privacy-safe support diagnostics" FontSize="18"
                                   FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="Create a local ZIP containing sanitized configuration, hardware information, model state, benchmark summaries and operational logs. Prompts, chat history, API keys, tokens, model weights and source images are excluded. Review the ZIP before sharing it."
                                   TextWrapping="Wrap" Opacity="0.8" />
                        <Button x:Name="DiagnosticsExportButton" Content="Export diagnostics ZIP"
                                IsEnabled="False" HorizontalAlignment="Left"
                                Click="DiagnosticsExportButton_Click" />
                        <TextBlock x:Name="DiagnosticsResult" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="StoragePanel" Visibility="Collapsed">
                    <StackPanel MaxWidth="800" HorizontalAlignment="Left" Spacing="14">
                        <TextBlock Text="Storage &amp; cache" FontSize="28"
                                   FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="Inspect managed model files, reusable Hugging Face downloads, interrupted preparation and compiled OpenVINO caches. All measurements and cleanup decisions come from the existing local engine."
                                   TextWrapping="Wrap" Opacity="0.8" />
                        <InfoBar x:Name="StorageInfo" Title="Storage manager"
                                 IsOpen="True" IsClosable="False"
                                 Severity="Informational"
                                 Message="Open Storage to inspect managed files. No files are removed automatically." />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="StorageRefreshButton" Content="Refresh inventory"
                                    Click="StorageRefreshButton_Click" />
                            <ProgressRing x:Name="StorageProgress" IsActive="False"
                                          Width="26" Height="26" />
                        </StackPanel>
                        <TextBlock x:Name="StorageSummary" IsTextSelectionEnabled="True"
                                   TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                                   Text="Connect to the local engine to view managed storage." />
                        <TextBlock Text="Managed files and cleanup options"
                                   FontSize="18" FontWeight="SemiBold" />
                        <StackPanel x:Name="StorageRows" Spacing="12" />
                        <TextBlock Text="Cleanup is never automatic. Unavailable actions remain disabled. Protected transaction backups are not eligible for removal. Source cache cleanup requires a future download; clearing compiled cache can slow the next load."
                                   TextWrapping="Wrap" Opacity="0.8" />
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="HuggingFacePanel" Visibility="Collapsed">
                    <StackPanel MaxWidth="800" HorizontalAlignment="Left" Spacing="14">
                        <TextBlock Text="Hugging Face" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Text="Connect your account and discover models through the existing InferBridge engine. Search results are not hardware compatibility or model-license approvals."
                                   TextWrapping="Wrap" Opacity="0.8" />
                        <InfoBar x:Name="HfInfo" IsOpen="True" IsClosable="False"
                                 Severity="Informational" Title="Hugging Face access"
                                 Message="Open this page to inspect the engine's account status." />
                        <ProgressRing x:Name="HfProgress" Width="26" Height="26"
                                      HorizontalAlignment="Left" IsActive="False" />
                        <TextBlock x:Name="HfAccountText" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite"
                                   Text="Not checked" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="HfRefreshButton" Content="Refresh account"
                                    Click="HfRefreshButton_Click" />
                            <Button x:Name="HfConnectButton" Content="Add or replace token"
                                    Click="HfConnectButton_Click" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="HfTestButton" Content="Test access"
                                    Click="HfTestButton_Click" IsEnabled="False" />
                            <Button x:Name="HfRemoveButton" Content="Remove stored token"
                                    Click="HfRemoveButton_Click" IsEnabled="False" />
                        </StackPanel>
                        <TextBlock Text="Use a Hugging Face user access token with read permission. InferBridge owns the credential in its existing Windows DPAPI-backed backend store. Environment-managed HF_TOKEN credentials cannot be removed here. Gated models may also require accepting their license on huggingface.co."
                                   TextWrapping="Wrap" Opacity="0.8" />
                        <TextBlock Text="Discover models" FontSize="18" FontWeight="SemiBold" />
                        <TextBox x:Name="HfSearchBox" Header="Model name or repository"
                                 PlaceholderText="e.g. SmolLM"
                                 MaxLength="200" HorizontalAlignment="Stretch"
                                 AutomationProperties.Name="Search Hugging Face models" />
                        <ComboBox x:Name="HfTaskPicker" Header="Model task"
                                  SelectedIndex="0" MinWidth="220" HorizontalAlignment="Left">
                            <ComboBoxItem Content="Text generation" Tag="text-generation" />
                            <ComboBoxItem Content="Embeddings" Tag="embeddings" />
                            <ComboBoxItem Content="Image and text" Tag="image-text-to-text" />
                        </ComboBox>
                        <Button x:Name="HfSearchButton" Content="Search Hugging Face"
                                Click="HfSearchButton_Click" IsEnabled="False"
                                HorizontalAlignment="Left"
                                Style="{StaticResource AccentButtonStyle}" />
                        <TextBlock x:Name="HfSearchSummary" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite"
                                   Text="Search is available when your local engine is connected." />
                        <StackPanel x:Name="HfSearchResults" Spacing="12" />
                        <TextBlock Text="Review model size, access restrictions, remote-code requirements, and compatibility before using the Model library to download or load. Discovery results are remote models, not installed models."
                                   TextWrapping="Wrap" Opacity="0.8" />
                    </StackPanel>
                </ScrollViewer>
                <Grid x:Name="ModelsPanel" Visibility="Collapsed" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="8">
                        <TextBlock Text="Model library" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock x:Name="ModelsSummary" TextWrapping="Wrap" />
                        <InfoBar x:Name="ModelsInfo" Title="Model library" IsOpen="False" IsClosable="True" />
                    </StackPanel>
                    <ListView x:Name="ModelsList" Grid.Row="1"
                              SelectionMode="Single"
                              SelectionChanged="ModelsList_SelectionChanged"
                              AutomationProperties.Name="Engine model inventory" />
                    <StackPanel Grid.Row="2" Spacing="8">
                        <ComboBox x:Name="LibraryDevicePicker" Header="Inference device"
                                  SelectedIndex="0" MinWidth="215" MaxWidth="280"
                                  HorizontalAlignment="Left"
                                  AutomationProperties.Name="Inference device for model loading">
                            <ComboBoxItem Content="Automatic (engine default)" Tag="" />
                            <ComboBoxItem Content="NPU" Tag="NPU" />
                            <ComboBoxItem Content="GPU" Tag="GPU" />
                            <ComboBoxItem Content="CPU" Tag="CPU" />
                        </ComboBox>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="DownloadButton" Content="Download and load" IsEnabled="False"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="DownloadButton_Click" />
                        <Button x:Name="LoadButton" Content="Load" IsEnabled="False"
                                Click="LoadButton_Click" />
                        <Button x:Name="UnloadButton" Content="Unload" IsEnabled="False"
                                Click="UnloadButton_Click" />
                        <Button x:Name="DeleteButton" Content="Delete local files" IsEnabled="False"
                                Click="DeleteButton_Click" />
                        <Button Content="Refresh" Click="RefreshButton_Click"
                                AutomationProperties.Name="Refresh models" />
                        </StackPanel>
                        <TextBlock x:Name="ModelPreparationSummary" Text="Select a model to inspect preparation."
                                   IsTextSelectionEnabled="True" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite" />
                        <ScrollViewer MaxHeight="108" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <TextBlock x:Name="ModelDetailsSummary" TextWrapping="Wrap"
                                       IsTextSelectionEnabled="True"
                                       AutomationProperties.Name="Selected model configuration and runtime details" />
                        </ScrollViewer>
                        <ProgressBar x:Name="ModelPreparationPercent" Minimum="0" Maximum="100"
                                     Value="0" Visibility="Collapsed" Height="6" />
                        <Button x:Name="CancelPreparationButton" Content="Cancel current preparation"
                                IsEnabled="False" HorizontalAlignment="Left"
                                Click="CancelPreparationButton_Click"
                                AutomationProperties.Name="Cancel selected model preparation" />
                        <Button x:Name="RecoverButton" Content="Review interrupted preparation"
                                HorizontalAlignment="Left" IsEnabled="False"
                                Click="RecoverButton_Click"
                                AutomationProperties.Name="Inspect and recover selected model" />
                    </StackPanel>
                </Grid>
                <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left" Spacing="14">
                        <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Text="Inference for this conversation" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Apply settings to future messages in the current native chat. Changes are not saved to disk or the engine, and reset when you switch models, start a new chat or restore history." TextWrapping="Wrap" Opacity="0.8" />
                        <InfoBar x:Name="GenerationSettingsInfo" Title="Engine defaults"
                                 Message="Adjust and apply controls for this chat."
                                 IsOpen="True" IsClosable="False" Severity="Informational" />
                        <TextBlock x:Name="SettingsCurrentModel" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite" />
                        <NumberBox x:Name="MaxTokensBox" Header="Maximum generated tokens"
                                   Value="512" Minimum="1" Maximum="4096" SmallChange="64"
                                   SpinButtonPlacementMode="Compact" ValidationMode="Disabled"
                                   AutomationProperties.Name="Maximum output tokens" />
                        <TextBlock Text="Engine default: 512. Actual generation can be shorter when context space is limited." TextWrapping="Wrap" Opacity="0.8" />
                        <NumberBox x:Name="TemperatureBox" Header="Temperature"
                                   Value="0.7" Minimum="0" Maximum="2" SmallChange="0.1"
                                   SpinButtonPlacementMode="Compact" ValidationMode="Disabled"
                                   AutomationProperties.Name="Temperature from zero to two" />
                        <TextBlock Text="Engine default: 0.7. Zero disables sampling; higher values increase variation." TextWrapping="Wrap" Opacity="0.8" />
                        <NumberBox x:Name="TopPBox" Header="Top-p sampling"
                                   Value="1" Minimum="0" Maximum="1" SmallChange="0.05"
                                   SpinButtonPlacementMode="Compact" ValidationMode="Disabled"
                                   AutomationProperties.Name="Top-p from zero to one" />
                        <TextBlock Text="Engine default: 1.0. Lower values restrict nucleus sampling." TextWrapping="Wrap" Opacity="0.8" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="ApplyGenerationSettingsButton" Content="Apply to this chat"
                                    Click="ApplyGenerationSettingsButton_Click" />
                            <Button x:Name="ResetGenerationSettingsButton" Content="Reset to engine defaults"
                                    Click="ResetGenerationSettingsButton_Click" />
                        </StackPanel>
                        <TextBlock Text="Select load devices in Model library. Persistent server configuration, model context, top-k, and repetition penalty cannot be modified through the existing chat API." TextWrapping="Wrap" Opacity="0.8" />
                    </StackPanel>
                </ScrollViewer>
                <Grid x:Name="ChatPanel" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="10">
                        <TextBlock Text="Chat" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Text="Saved conversations" FontWeight="SemiBold" FontSize="16" />
                        <TextBox x:Name="SavedChatsSearch" Header="Search saved conversations"
                                 PlaceholderText="Search titles, models, and messages on this PC"
                                 TextChanged="SavedChatsSearch_TextChanged" MaxLength="120"
                                 MinWidth="230" MaxWidth="460"
                                 HorizontalAlignment="Left"
                                 AutomationProperties.Name="Search local saved conversations" />
                        <StackPanel Spacing="8">
                            <ComboBox x:Name="SavedChatsPicker" PlaceholderText="Select a saved conversation"
                                      MinWidth="230" MaxWidth="430" HorizontalAlignment="Left"
                                      AutomationProperties.Name="Select a saved conversation"
                                      SelectionChanged="SavedChatsPicker_SelectionChanged" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button x:Name="RenameSavedChatButton" Content="Rename"
                                        IsEnabled="False" Click="RenameSavedChatButton_Click" />
                                <Button x:Name="DeleteSavedChatButton" Content="Delete saved chat"
                                        IsEnabled="False" Click="DeleteSavedChatButton_Click" />
                            </StackPanel>
                        </StackPanel>
                        <CheckBox x:Name="SaveHistoryToggle"
                                  Content="Save completed chats locally (plain text on this PC)"
                                  Checked="SaveHistoryToggle_Changed"
                                  Unchecked="SaveHistoryToggle_Changed" />
                        <TextBlock Text="Off by default. When enabled, completed chats are saved in this installation's local data folder, separate from browser history. Other apps with access to your account may read these files."
                                   TextWrapping="Wrap" Opacity="0.8" />
                        <ComboBox x:Name="ChatModelPicker" Header="Chat model"
                                  PlaceholderText="Choose a downloaded model"
                                  MinWidth="230" MaxWidth="460"
                                  HorizontalAlignment="Left"
                                  SelectionChanged="ChatModelPicker_SelectionChanged"
                                  AutomationProperties.Name="Select a downloaded or loaded inference model" />
                        <TextBlock Text="Select a downloaded model to load it here. New downloads are available in Model library."
                                   TextWrapping="Wrap" Opacity="0.8" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="Inference settings" Click="OpenGenerationSettingsButton_Click" />
                            <TextBlock x:Name="ChatGenerationSummary" VerticalAlignment="Center"
                                       TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                        <InfoBar x:Name="ChatInfo" IsOpen="True" IsClosable="False"
                                 Severity="Informational" Title="Getting ready"
                                 Message="Connect to your engine and load a model to begin." />
                    </StackPanel>
                    <ListView x:Name="ChatHistory" Grid.Row="1"
                              SelectionMode="None"
                              AutomationProperties.Name="Conversation history" />
                    <StackPanel Grid.Row="2" Spacing="8">
                        <TextBox x:Name="PromptBox" Header="Message"
                                 PlaceholderText="Ask your local model…"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="88" MaxHeight="160" MaxLength="8000"
                                 AutomationProperties.Name="Chat prompt" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="SendButton" Content="Send" IsEnabled="False"
                                    Click="SendButton_Click">
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="Enter" Modifiers="Control" />
                                </Button.KeyboardAccelerators>
                            </Button>
                            <Button x:Name="CancelButton" Content="Cancel response"
                                    IsEnabled="False" Click="CancelButton_Click" />
                            <Button Content="New chat" Click="NewChatButton_Click" />
                            <ProgressRing x:Name="ChatProgress" IsActive="False"
                                          Width="24" Height="24" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
