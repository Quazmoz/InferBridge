<Window
    x:Class="InferBridge.Native.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="InferBridge">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <NavigationView x:Name="MainNavigation"
                        PaneDisplayMode="Auto"
                        CompactModeThresholdWidth="720"
                        ExpandedModeThresholdWidth="1050"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        OpenPaneLength="220"
                        SelectionChanged="MainNavigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Icon="Message" Content="Chat" Tag="chat" />
                <NavigationViewItem Icon="Library" Content="Model library" Tag="models" />
                <NavigationViewItem Icon="Find" Content="Hugging Face" Tag="huggingface" />
                <NavigationViewItem Icon="Home" Content="Engine" Tag="overview" />
                <NavigationViewItem Icon="Link" Content="Local API" Tag="connection" />
                <NavigationViewItem Icon="Setting" Content="Operations" Tag="operations"
                                    ToolTipService.ToolTip="Operations &amp; diagnostics" />
                <NavigationViewItem Icon="Preview" Content="Benchmark Lab" Tag="benchmark" />
                <NavigationViewItem Icon="Repair" Content="System Doctor" Tag="doctor" />
                <NavigationViewItem Icon="Save" Content="Storage &amp; cache" Tag="storage" />
                <NavigationViewItem x:Name="SettingsNavigationItem" Icon="Setting" Content="Settings" Tag="settings" />
            </NavigationView.MenuItems>
            <Grid Padding="24,12,24,20">
                <ScrollViewer x:Name="OverviewPanel" Visibility="Collapsed"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="16" MaxWidth="700" HorizontalAlignment="Left">
                        <TextBlock Text="Your local AI engine" FontSize="28"
                                   FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="Inference and model files stay in the existing Python/OpenVINO engine."
                                   TextWrapping="Wrap" Opacity="0.8" />
                        <InfoBar x:Name="ConnectionInfo" Title="Local engine"
                                 Severity="Informational" IsOpen="True"
                                 IsClosable="False" Message="Checking the local engine…" />
                        <ProgressRing x:Name="ConnectionProgress" Width="30" Height="30"
                                      IsActive="False" HorizontalAlignment="Left" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="RefreshButton" Content="Refresh status"
                                    Click="RefreshButton_Click" />
                            <Button x:Name="StartButton" Content="Start local engine"
                                    Click="StartButton_Click" />
                        </StackPanel>
                        <TextBlock x:Name="ConnectionDetails" TextWrapping="Wrap" Opacity="0.8" />
                        <TextBlock Text="Hardware &amp; inference" FontWeight="SemiBold" FontSize="18" />
                        <TextBlock x:Name="HardwareSummary" Text="Connect to inspect available inference devices."
                                   TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        <Button x:Name="ScanHardwareButton" Content="Scan inference devices"
                                HorizontalAlignment="Left" Click="ScanHardwareButton_Click" />
                        <TextBlock Text="API authentication" FontWeight="SemiBold" FontSize="18" />
                        <TextBlock Text="If your engine uses an API key, enter it for this window only. InferBridge never saves it or sends it to tray-control endpoints."
                                   TextWrapping="Wrap" Opacity="0.8" />
                        <PasswordBox x:Name="ApiKeyBox" Header="Engine API key"
                                     PlaceholderText="Optional bearer key"
                                     MaxLength="512" Width="360"
                                     HorizontalAlignment="Left" />
                        <Button Content="Connect with key" HorizontalAlignment="Left"
                                Click="RefreshButton_Click" />
                        <InfoBar Title="Native Windows"
                                 IsOpen="True" IsClosable="False"
                                 Severity="Informational"
                                 Message="This is a WinUI 3 client. It does not embed a web page or own a second inference engine." />
                        <InfoBar x:Name="WebUiInfo" Title="Web GUI (optional)"
                                 Message="The browser interface is secondary. Open it only when needed."
                                 IsOpen="True" IsClosable="False" Severity="Informational">
                            <InfoBar.ActionButton>
                                <Button x:Name="WebUiButton" Content="Open web GUI" IsEnabled="False"
                                        Click="WebUiButton_Click" />
                            </InfoBar.ActionButton>
                        </InfoBar>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="ConnectionHubPanel" Visibility="Collapsed"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left" Spacing="14">
                        <TextBlock Text="Local Connection Hub" FontSize="28" FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Connect Python, Windows curl.exe, and other OpenAI-compatible clients to this running InferBridge engine. All details come from its verified local session."
                                   TextWrapping="Wrap" Opacity="0.8" />
                        <InfoBar x:Name="HubInfo" Title="Connection details" IsOpen="True"
                                 IsClosable="False" Severity="Informational"
                                 Message="Open this page to inspect the local API." />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="HubRefreshButton" Content="Refresh connection"
                                    Click="HubRefreshButton_Click" />
                            <ProgressRing x:Name="HubProgress" Width="24" Height="24"
                                          IsActive="False" />
                        </StackPanel>
                        <TextBlock Text="OpenAI-compatible Base URL" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="HubBaseUrl" Text="Not connected" TextWrapping="Wrap"
                                   FontFamily="Consolas" IsTextSelectionEnabled="True"
                                   AutomationProperties.Name="Actual local OpenAI Base URL" />
                        <Button x:Name="HubCopyBaseUrlButton" Content="Copy Base URL"
                                HorizontalAlignment="Left" IsEnabled="False"
                                Click="HubCopyBaseUrlButton_Click" />
                        <TextBlock x:Name="HubListenerStatus" TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True" />
                        <TextBlock x:Name="HubAuthenticationStatus" TextWrapping="Wrap" />
                        <TextBlock x:Name="HubLanStatus" TextWrapping="Wrap" />
                        <TextBlock Text="Generation model" FontSize="18" FontWeight="SemiBold" />
                        <ComboBox x:Name="HubModelPicker" PlaceholderText="Choose loaded chat model"
                                  HorizontalAlignment="Stretch" IsEnabled="False"
                                  SelectionChanged="HubModelPicker_SelectionChanged"
                                  AutomationProperties.Name="Model ID for API examples and self-test" />
                        <TextBlock x:Name="HubModelHint" Text="A loaded generation model is required for generation checks."
                                   TextWrapping="Wrap" Opacity="0.8" />
                        <TextBlock Text="Python OpenAI SDK" FontSize="18" FontWeight="SemiBold" />
                        <TextBox x:Name="HubPythonExample" IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="NoWrap" MinHeight="150" MaxHeight="230"
                                 AutomationProperties.Name="Copyable Python SDK connection example" />
                        <Button x:Name="HubCopyPythonButton" Content="Copy Python example"
                                IsEnabled="False" HorizontalAlignment="Left"
                                Click="HubCopyPythonButton_Click" />
                        <TextBlock Text="Windows curl.exe" FontSize="18" FontWeight="SemiBold" />
                        <TextBox x:Name="HubCurlExample" IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="Wrap" MinHeight="64"
                                 AutomationProperties.Name="Copyable Windows curl.exe model list example" />
                        <Button x:Name="HubCopyCurlButton" Content="Copy curl.exe example"
                                IsEnabled="False" HorizontalAlignment="Left"
                                Click="HubCopyCurlButton_Click" />
                        <TextBlock Text="Connection self-test" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Checks model listing, non-streaming and streaming generation, cancellation recovery, and authentication separately using synthetic prompts. It does not change model files."
                                   TextWrapping="Wrap" Opacity="0.8" />
                        <Button x:Name="HubTestButton" Content="Run connection self-test"
                                IsEnabled="False" HorizontalAlignment="Left"
                                Click="HubTestButton_Click" />
                        <TextBlock x:Name="HubTestSummary" Text="No self-test run yet."
                                   TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        <ListView x:Name="HubTestResults" SelectionMode="None"
                                  AutomationProperties.Name="Individual local API self-test results" />
                        <TextBlock Text="Credentials are never copied. For secured engines, replace the example placeholder with your own API key in your client. Native settings do not enable LAN access or change firewall rules."
                                   TextWrapping="Wrap" Opacity="0.8" />
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="DoctorPanel" Visibility="Collapsed"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="800" HorizontalAlignment="Left" Spacing="14">
                        <TextBlock Text="System Doctor" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Text="Run read-only checks using the same engine and device endpoints as the web GUI. Results reflect this machine, not a separate native inference engine."
                                   TextWrapping="Wrap" Opacity="0.8" />
                        <InfoBar x:Name="DoctorInfo" Title="System Doctor"
                                 IsOpen="True" IsClosable="False"
                                 Severity="Informational"
                                 Message="Select Run checks to inspect the local runtime." />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="DoctorRefreshButton" Content="Run checks again"
                                    Click="DoctorRefreshButton_Click" />
                            <Button x:Name="DoctorCopyButton" Content="Copy sanitized support report"
                                    IsEnabled="False" Click="DoctorCopyButton_Click" />
                            <ProgressRing x:Name="DoctorProgress" Width="26" Height="26"
                                          IsActive="False" />
                        </StackPanel>
                        <TextBlock x:Name="DoctorSummary" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite"
                                   IsTextSelectionEnabled="True"
                                   Text="Open System Doctor to inspect hardware and runtime readiness." />
                        <TextBlock Text="Detected OpenVINO devices" FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="DoctorDevices" TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True" Text="Not checked" />
                        <TextBlock Text="Model readiness" FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="DoctorModels" TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True" Text="Not checked" />
                        <TextBlock Text="Checks and recommended actions" FontSize="18"
                                   FontWeight="SemiBold" />
                        <ItemsControl x:Name="DoctorChecks"
                                      AutomationProperties.Name="System Doctor health checks" />
                        <TextBlock Text="The support report excludes credentials, prompts, chat content, model errors, and local file paths. Review copied text before sharing."
                                   TextWrapping="Wrap" Opacity="0.8" />
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="OperationsPanel" Visibility="Collapsed"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left" Spacing="16">
                        <TextBlock Text="Operations &amp; diagnostics" FontSize="28"
                                   FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="Native controls for the same local engine operations available in the web GUI."
                                   TextWrapping="Wrap" Opacity="0.8" />
                        <InfoBar x:Name="OperationsInfo" Title="Engine operations"
                                 IsOpen="True" IsClosable="False"
                                 Message="Open this page to inspect the current engine state."
                                 Severity="Informational" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="OperationsRefreshButton" Content="Refresh operations"
                                    Click="OperationsRefreshButton_Click" />
                            <ProgressRing x:Name="OperationsProgress" IsActive="False"
                                          Width="28" Height="28" />
                        </StackPanel>
                        <TextBlock Text="Engine &amp; installation" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="OperationsDetails" TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True"
                                   AutomationProperties.LiveSetting="Polite"
                                   Text="Connect to the local engine to view its status." />
                        <TextBlock Text="Hardware benchmarks" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="OperationsBenchmarks" TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True"
                                   Text="The engine has not reported benchmark status." />
                        <TextBlock Text="Quick benchmark runs one local measurement (32 generated tokens) on the currently loaded model and actual device. It may use significant CPU, GPU, NPU, memory and time. Mock results are synthetic." TextWrapping="Wrap" Opacity="0.8" />
                        <Button x:Name="QuickBenchmarkButton" Content="Run quick benchmark" IsEnabled="False"
                                HorizontalAlignment="Left" Click="QuickBenchmarkButton_Click" />
                        <TextBlock x:Name="BenchmarkRunResult" TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True"
                                   AutomationProperties.LiveSetting="Polite" />
                        <TextBlock Text="Privacy-safe support diagnostics" FontSize="18"
                                   FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="Create a local ZIP containing sanitized configuration, hardware information, model state, benchmark summaries and operational logs. Prompts, chat history, API keys, tokens, model weights and source images are excluded. Review the ZIP before sharing it."
                                   TextWrapping="Wrap" Opacity="0.8" />
                        <Button x:Name="DiagnosticsExportButton" Content="Export diagnostics ZIP"
                                IsEnabled="False" HorizontalAlignment="Left"
                                Click="DiagnosticsExportButton_Click" />
                        <TextBlock x:Name="DiagnosticsResult" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="BenchmarkPanel" Visibility="Collapsed"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="840" HorizontalAlignment="Stretch" Spacing="14">
                        <TextBlock Text="Benchmark Lab" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Text="Review local benchmark runs and compare compatible measurements. The Python/OpenVINO engine owns every measurement and the saved history."
                                   TextWrapping="Wrap" Opacity="0.8" />
                        <TextBlock Text="Configure a benchmark" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Choose prepared generation models and devices reported by this engine. Selections do not load or download models."
                                   TextWrapping="Wrap" Opacity="0.8" />
                        <InfoBar x:Name="BenchmarkConfigurationInfo" Title="Benchmark configuration"
                                 IsOpen="True" IsClosable="False" Severity="Informational"
                                 Message="Refresh engine capabilities to configure a local benchmark." />
                        <Button x:Name="BenchmarkConfigurationRefreshButton" Content="Refresh models and devices"
                                HorizontalAlignment="Left"
                                Click="BenchmarkConfigurationRefreshButton_Click" />
                        <TextBlock Text="Generation models" FontWeight="SemiBold" />
                        <ScrollViewer MaxHeight="224" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="BenchmarkModelChoices" Spacing="4">
                                <TextBlock Text="No model inventory loaded." TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                        <TextBlock Text="Requested execution devices" FontWeight="SemiBold" />
                        <StackPanel x:Name="BenchmarkDeviceChoices" Spacing="4">
                            <TextBlock Text="No devices reported." TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox x:Name="BenchmarkPresetPicker" Header="Benchmark thoroughness"
                                  HorizontalAlignment="Stretch" MaxWidth="400"
                                  AutomationProperties.Name="Benchmark workload preset"
                                  SelectedIndex="1"
                                  >
                            <ComboBoxItem Content="Quick · 1 warm-up, 3 measured, 32 tokens" Tag="quick" />
                            <ComboBoxItem Content="Standard · 1 warm-up, 5 measured, 64 tokens" Tag="standard" />
                            <ComboBoxItem Content="Thorough · 2 warm-ups, 8 measured, 128 tokens" Tag="thorough" />
                        </ComboBox>
                        <TextBlock x:Name="BenchmarkWorkload" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite"
                                   Text="Select prepared models and detected devices to estimate the workload." />
                        <Button x:Name="BenchmarkRunButton" Content="Start benchmark" IsEnabled="False"
                                HorizontalAlignment="Left" Click="BenchmarkRunButton_Click" />
                        <ProgressBar x:Name="BenchmarkActivityProgress" Minimum="0" Maximum="100"
                                     IsIndeterminate="False" Value="0" Height="4"
                                     AutomationProperties.Name="Engine-reported benchmark completion" />
                        <StackPanel Spacing="6">
                            <ProgressRing x:Name="BenchmarkActivityRing" Width="22" Height="22"
                                          IsActive="False" />
                            <TextBlock x:Name="BenchmarkActivityLabel" TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Polite"
                                       Text="No benchmark running in this window." />
                        </StackPanel>
                        <TextBlock Text="No benchmark cancellation API is available. Stopping monitoring or closing the window is not a cancellation command. Requested AUTO and actual execution devices are reported separately."
                                   TextWrapping="Wrap" Opacity="0.8" />
                        <TextBlock Text="Benchmark history" FontSize="18" FontWeight="SemiBold" />
                        <InfoBar x:Name="BenchmarkHistoryInfo" Title="Benchmark history"
                                 IsOpen="True" IsClosable="False" Severity="Informational"
                                 Message="Open Benchmark Lab to load measured results from the local engine." />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="BenchmarkHistoryRefreshButton" Content="Refresh history"
                                    Click="BenchmarkHistoryRefreshButton_Click" />
                            <ProgressRing x:Name="BenchmarkHistoryProgress" IsActive="False"
                                          Width="26" Height="26" />
                            <Button Content="Quick benchmark" Click="BenchmarkOpenQuickButton_Click" />
                        </StackPanel>
                        <TextBlock Text="Saved manual runs" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Up to 100 recent runs are read from the engine. Automatic advisor runs are omitted. No benchmark is started when selecting history."
                                   TextWrapping="Wrap" Opacity="0.8" />
                        <ComboBox x:Name="BenchmarkPrimaryPicker" Header="View a benchmark run"
                                  AutomationProperties.Name="Select saved benchmark run"
                                  HorizontalAlignment="Stretch" MaxWidth="700" MinWidth="260"
                                  SelectionChanged="BenchmarkPicker_SelectionChanged" />
                        <StackPanel x:Name="BenchmarkDetailsRows" Spacing="10">
                            <TextBlock Text="No run selected." TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Text="Compare previous evidence" FontSize="18"
                                   FontWeight="SemiBold" />
                        <ComboBox x:Name="BenchmarkComparePicker" Header="Compare with another run"
                                  PlaceholderText="No comparison selected"
                                  AutomationProperties.Name="Select comparison benchmark run"
                                  HorizontalAlignment="Stretch" MaxWidth="700" MinWidth="260"
                                  SelectionChanged="BenchmarkPicker_SelectionChanged" />
                        <TextBlock x:Name="BenchmarkComparisonSummary" TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True"
                                   AutomationProperties.LiveSetting="Polite"
                                   Text="Choose two compatible runs to see measured changes." />
                        <TextBlock Text="A comparison requires matching hardware fingerprint, synthetic/real mode, methodology, output tokens, measured runs, warm-ups, model, source, precision, requested device and actual execution device. Unavailable measurements never become zero or invented deltas."
                                   TextWrapping="Wrap" Opacity="0.8" />
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="StoragePanel" Visibility="Collapsed"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="800" HorizontalAlignment="Left" Spacing="14">
                        <TextBlock Text="Storage &amp; cache" FontSize="28"
                                   FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="Inspect managed model files, reusable Hugging Face downloads, interrupted preparation and compiled OpenVINO caches. All measurements and cleanup decisions come from the existing local engine."
                                   TextWrapping="Wrap" Opacity="0.8" />
                        <InfoBar x:Name="StorageInfo" Title="Storage manager"
                                 IsOpen="True" IsClosable="False"
                                 Severity="Informational"
                                 Message="Open Storage to inspect managed files. No files are removed automatically." />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="StorageRefreshButton" Content="Refresh inventory"
                                    Click="StorageRefreshButton_Click" />
                            <ProgressRing x:Name="StorageProgress" IsActive="False"
                                          Width="26" Height="26" />
                        </StackPanel>
                        <TextBlock x:Name="StorageSummary" IsTextSelectionEnabled="True"
                                   TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                                   Text="Connect to the local engine to view managed storage." />
                        <TextBlock Text="Managed files and cleanup options"
                                   FontSize="18" FontWeight="SemiBold" />
                        <StackPanel x:Name="StorageRows" Spacing="12" />
                        <TextBlock Text="Cleanup is never automatic. Unavailable actions remain disabled. Protected transaction backups are not eligible for removal. Source cache cleanup requires a future download; clearing compiled cache can slow the next load."
                                   TextWrapping="Wrap" Opacity="0.8" />
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="HuggingFacePanel" Visibility="Collapsed"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="800" HorizontalAlignment="Left" Spacing="14">
                        <TextBlock Text="Hugging Face" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Text="Connect your account and discover models through the existing InferBridge engine. Search results are not hardware compatibility or model-license approvals."
                                   TextWrapping="Wrap" Opacity="0.8" />
                        <InfoBar x:Name="HfInfo" IsOpen="True" IsClosable="False"
                                 Severity="Informational" Title="Hugging Face access"
                                 Message="Open this page to inspect the engine's account status." />
                        <ProgressRing x:Name="HfProgress" Width="26" Height="26"
                                      HorizontalAlignment="Left" IsActive="False" />
                        <TextBlock x:Name="HfAccountText" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite"
                                   Text="Not checked" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="HfRefreshButton" Content="Refresh account"
                                    Click="HfRefreshButton_Click" />
                            <Button x:Name="HfConnectButton" Content="Add or replace token"
                                    Click="HfConnectButton_Click" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="HfTestButton" Content="Test access"
                                    Click="HfTestButton_Click" IsEnabled="False" />
                            <Button x:Name="HfRemoveButton" Content="Remove stored token"
                                    Click="HfRemoveButton_Click" IsEnabled="False" />
                        </StackPanel>
                        <TextBlock Text="Use a Hugging Face user access token with read permission. InferBridge owns the credential in its existing Windows DPAPI-backed backend store. Environment-managed HF_TOKEN credentials cannot be removed here. Gated models may also require accepting their license on huggingface.co."
                                   TextWrapping="Wrap" Opacity="0.8" />
                        <TextBlock Text="Discover models" FontSize="18" FontWeight="SemiBold" />
                        <TextBox x:Name="HfSearchBox" Header="Model name or repository"
                                 PlaceholderText="e.g. SmolLM"
                                 MaxLength="200" HorizontalAlignment="Stretch"
                                 AutomationProperties.Name="Search Hugging Face models" />
                        <ComboBox x:Name="HfTaskPicker" Header="Model task"
                                  SelectedIndex="0" MinWidth="220" HorizontalAlignment="Left">
                            <ComboBoxItem Content="Text generation" Tag="text-generation" />
                            <ComboBoxItem Content="Embeddings" Tag="embeddings" />
                            <ComboBoxItem Content="Image and text" Tag="image-text-to-text" />
                        </ComboBox>
                        <Button x:Name="HfSearchButton" Content="Search Hugging Face"
                                Click="HfSearchButton_Click" IsEnabled="False"
                                HorizontalAlignment="Left"
                                Style="{StaticResource AccentButtonStyle}" />
                        <TextBlock x:Name="HfSearchSummary" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite"
                                   Text="Search is available when your local engine is connected." />
                        <StackPanel x:Name="HfSearchResults" Spacing="12" />
                        <TextBlock Text="Review model size, access restrictions, remote-code requirements, and compatibility before using the Model library to download or load. Discovery results are remote models, not installed models."
                                   TextWrapping="Wrap" Opacity="0.8" />
                    </StackPanel>
                </ScrollViewer>
                <!-- Restrict chrome height so the model inventory stays usable in small windows. -->
                <Grid x:Name="ModelsPanel" Visibility="Collapsed" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Model library" FontSize="28" FontWeight="SemiBold" />
                            <TextBlock x:Name="ModelsSummary" TextWrapping="Wrap" />
                            <InfoBar x:Name="ModelsInfo" Title="Model library" IsOpen="False"
                                     IsClosable="True" />
                        </StackPanel>
                    </ScrollViewer>
                    <ListView x:Name="ModelsList" Grid.Row="1"
                              SelectionMode="Single"
                              SelectionChanged="ModelsList_SelectionChanged"
                              HorizontalContentAlignment="Stretch"
                              AutomationProperties.Name="Engine model inventory" />
                    <ScrollViewer Grid.Row="2" MaxHeight="208"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  AutomationProperties.Name="Selected model actions and details">
                        <StackPanel Spacing="8">
                            <ComboBox x:Name="LibraryDevicePicker" Header="Inference device"
                                      SelectedIndex="0" MinWidth="215" MaxWidth="280"
                                      HorizontalAlignment="Left"
                                      AutomationProperties.Name="Inference device for model loading">
                                <ComboBoxItem Content="Automatic (engine default)" Tag="" />
                                <ComboBoxItem Content="NPU" Tag="NPU" />
                                <ComboBoxItem Content="GPU" Tag="GPU" />
                                <ComboBoxItem Content="CPU" Tag="CPU" />
                            </ComboBox>
                            <Grid RowSpacing="8" ColumnSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="DownloadButton" Grid.Row="0" Grid.Column="0"
                                        Content="Download and load" IsEnabled="False"
                                        HorizontalAlignment="Stretch"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Click="DownloadButton_Click" />
                                <Button x:Name="LoadButton" Grid.Row="0" Grid.Column="1"
                                        Content="Load" HorizontalAlignment="Stretch"
                                        IsEnabled="False" Click="LoadButton_Click" />
                                <Button x:Name="UnloadButton" Grid.Row="1" Grid.Column="0"
                                        Content="Unload" HorizontalAlignment="Stretch"
                                        IsEnabled="False" Click="UnloadButton_Click" />
                                <Button x:Name="DeleteButton" Grid.Row="1" Grid.Column="1"
                                        Content="Delete local files" HorizontalAlignment="Stretch"
                                        IsEnabled="False" Click="DeleteButton_Click" />
                                <Button Grid.Row="2" Grid.Column="0" Content="Refresh"
                                        HorizontalAlignment="Stretch" Click="RefreshButton_Click"
                                        AutomationProperties.Name="Refresh models" />
                            </Grid>
                            <TextBlock x:Name="ModelPreparationSummary"
                                       Text="Select a model to inspect preparation."
                                       IsTextSelectionEnabled="True" TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Polite" />
                            <TextBlock x:Name="ModelDetailsSummary" TextWrapping="Wrap"
                                       IsTextSelectionEnabled="True"
                                       AutomationProperties.Name="Selected model configuration and runtime details" />
                            <ProgressBar x:Name="ModelPreparationPercent" Minimum="0"
                                         Maximum="100" Value="0" Visibility="Collapsed" Height="6" />
                            <Button x:Name="CancelPreparationButton"
                                    Content="Cancel current preparation"
                                    IsEnabled="False" HorizontalAlignment="Left"
                                    Click="CancelPreparationButton_Click"
                                    AutomationProperties.Name="Cancel selected model preparation" />
                            <Button x:Name="RecoverButton" Content="Review interrupted preparation"
                                    HorizontalAlignment="Left" IsEnabled="False"
                                    Click="RecoverButton_Click"
                                    AutomationProperties.Name="Inspect and recover selected model" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left" Spacing="14">
                        <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Text="Inference for this conversation" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Apply settings to future messages in the current native chat. Changes are not saved to disk or the engine, and reset when you switch models, start a new chat or restore history." TextWrapping="Wrap" Opacity="0.8" />
                        <InfoBar x:Name="GenerationSettingsInfo" Title="Engine defaults"
                                 Message="Adjust and apply controls for this chat."
                                 IsOpen="True" IsClosable="False" Severity="Informational" />
                        <TextBlock x:Name="SettingsCurrentModel" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite" />
                        <NumberBox x:Name="MaxTokensBox" Header="Maximum generated tokens"
                                   Value="512" Minimum="1" Maximum="4096" SmallChange="64"
                                   SpinButtonPlacementMode="Compact" ValidationMode="Disabled"
                                   AutomationProperties.Name="Maximum output tokens" />
                        <TextBlock Text="Engine default: 512. Actual generation can be shorter when context space is limited." TextWrapping="Wrap" Opacity="0.8" />
                        <NumberBox x:Name="TemperatureBox" Header="Temperature"
                                   Value="0.7" Minimum="0" Maximum="2" SmallChange="0.1"
                                   SpinButtonPlacementMode="Compact" ValidationMode="Disabled"
                                   AutomationProperties.Name="Temperature from zero to two" />
                        <TextBlock Text="Engine default: 0.7. Zero disables sampling; higher values increase variation." TextWrapping="Wrap" Opacity="0.8" />
                        <NumberBox x:Name="TopPBox" Header="Top-p sampling"
                                   Value="1" Minimum="0" Maximum="1" SmallChange="0.05"
                                   SpinButtonPlacementMode="Compact" ValidationMode="Disabled"
                                   AutomationProperties.Name="Top-p from zero to one" />
                        <TextBlock Text="Engine default: 1.0. Lower values restrict nucleus sampling." TextWrapping="Wrap" Opacity="0.8" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="ApplyGenerationSettingsButton" Content="Apply to this chat"
                                    Click="ApplyGenerationSettingsButton_Click" />
                            <Button x:Name="ResetGenerationSettingsButton" Content="Reset to engine defaults"
                                    Click="ResetGenerationSettingsButton_Click" />
                        </StackPanel>
                        <TextBlock Text="Per-model context window" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Model context persists across restarts. Applying to a loaded model rebuilds its OpenVINO engine; your chat history stays intact. Larger values are trials until verified on this hardware." TextWrapping="Wrap" Opacity="0.8" />
                        <InfoBar x:Name="ContextConfigurationInfo" Title="Context configuration"
                                 Message="Load a model to inspect available context settings."
                                 IsOpen="True" IsClosable="False" Severity="Informational" />
                        <ComboBox x:Name="ContextSizePicker" Header="Context window tokens"
                                  MinWidth="240" AutomationProperties.Name="Model context window" />
                        <TextBlock x:Name="ContextMemoryGuidance" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="ContextApplyButton" Content="Apply model context"
                                    IsEnabled="False" Click="ContextApplyButton_Click" />
                            <Button x:Name="ContextResetButton" Content="Restore recommended"
                                    IsEnabled="False" Click="ContextResetButton_Click" />
                            <Button Content="Refresh" Click="ContextRefreshButton_Click" />
                        </StackPanel>
                        <TextBlock Text="Select load devices in Model library. Top-k and repetition penalty are not exposed by the existing chat API." TextWrapping="Wrap" Opacity="0.8" />
                    </StackPanel>
                </ScrollViewer>
                <!-- One compact command bar; saved-chat and detailed status flyouts
                     never consume the transcript's star-sized viewport. -->
                <Grid x:Name="ChatPanel" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="ChatToolbar" Grid.Row="0" ColumnSpacing="6"
                          SizeChanged="ChatToolbar_SizeChanged"
                          VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="ChatToolbarTitle" Grid.Column="0" Spacing="0"
                                    VerticalAlignment="Center" MaxWidth="126">
                            <TextBlock Text="Chat" FontSize="24" FontWeight="SemiBold" />
                            <TextBlock x:Name="ChatGenerationSummary"
                                       FontSize="11" Opacity="0.7"
                                       TextTrimming="CharacterEllipsis"
                                       AutomationProperties.Name="Current inference settings" />
                        </StackPanel>
                        <ComboBox x:Name="ChatModelPicker" Grid.Column="1"
                                  PlaceholderText="Select model"
                                  MinWidth="140"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  SelectionChanged="ChatModelPicker_SelectionChanged"
                                  AutomationProperties.Name="Select a downloaded or loaded inference model"
                                  ToolTipService.ToolTip="Chat model" />
                        <Button x:Name="ChatStatusButton" Grid.Column="2"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Chat status details"
                                ToolTipService.ToolTip="Show complete chat status">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE946;" />
                                    <TextBlock x:Name="ChatStatusText" Text="Starting"
                                               MaxWidth="74" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button.Content>
                            <Button.Flyout>
                                <Flyout>
                                    <InfoBar x:Name="ChatInfo" MaxWidth="420"
                                             IsOpen="True" IsClosable="False"
                                             Severity="Informational" Title="Getting ready"
                                             Message="Connect to your engine and load a model to begin." />
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button Grid.Column="3" VerticalAlignment="Center"
                                AutomationProperties.Name="Manage saved conversations"
                                ToolTipService.ToolTip="Saved conversations">
                            <Button.Content>
                                <SymbolIcon Symbol="Library" />
                            </Button.Content>
                            <Button.Flyout>
                                <Flyout>
                                    <ScrollViewer MaxHeight="340"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel Width="340" Spacing="10">
                                            <TextBlock Text="Saved conversations" FontSize="18"
                                                       FontWeight="SemiBold" />
                                            <TextBox x:Name="SavedChatsSearch"
                                                     Header="Search saved conversations"
                                                     PlaceholderText="Search titles, models, and messages on this PC"
                                                     TextChanged="SavedChatsSearch_TextChanged" MaxLength="120"
                                                     HorizontalAlignment="Stretch"
                                                     AutomationProperties.Name="Search local saved conversations" />
                                            <ComboBox x:Name="SavedChatsPicker"
                                                      PlaceholderText="Select a saved conversation"
                                                      HorizontalAlignment="Stretch"
                                                      AutomationProperties.Name="Select a saved conversation"
                                                      SelectionChanged="SavedChatsPicker_SelectionChanged" />
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Button x:Name="RenameSavedChatButton" Content="Rename"
                                                        IsEnabled="False" Click="RenameSavedChatButton_Click" />
                                                <Button x:Name="DeleteSavedChatButton" Content="Delete saved chat"
                                                        IsEnabled="False" Click="DeleteSavedChatButton_Click" />
                                            </StackPanel>
                                            <CheckBox x:Name="SaveHistoryToggle"
                                                      Content="Save completed chats locally"
                                                      Checked="SaveHistoryToggle_Changed"
                                                      Unchecked="SaveHistoryToggle_Changed" />
                                            <TextBlock Text="Off by default. Saved chats are plain text on this PC, separate from browser history. Other apps with access to your account may read these files."
                                                       TextWrapping="Wrap" Opacity="0.8" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button Grid.Column="4" VerticalAlignment="Center"
                                Click="OpenGenerationSettingsButton_Click"
                                AutomationProperties.Name="Inference settings"
                                ToolTipService.ToolTip="Inference settings">
                            <SymbolIcon Symbol="Setting" />
                        </Button>
                        <Button x:Name="NewChatButton" Grid.Column="5" VerticalAlignment="Center"
                                Click="NewChatButton_Click"
                                AutomationProperties.Name="New conversation"
                                ToolTipService.ToolTip="New chat">
                            <SymbolIcon Symbol="Add" />
                        </Button>
                    </Grid>
                    <Grid Grid.Row="1" MinHeight="0">
                        <ListView x:Name="ChatHistory"
                                  SelectionMode="None"
                                  HorizontalContentAlignment="Stretch"
                                  AutomationProperties.Name="Conversation history" />
                        <StackPanel x:Name="ChatEmptyState" Spacing="8"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    MaxWidth="360" IsHitTestVisible="False"
                                    AutomationProperties.AccessibilityView="Raw">
                            <TextBlock Text="Start a conversation" FontSize="22"
                                       FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="Select a local model above, then write a message below. Replies appear here."
                                       TextAlignment="Center" TextWrapping="Wrap"
                                       Opacity="0.7" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="2" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox x:Name="PromptBox" Grid.Row="0"
                                 PlaceholderText="Message your local model…"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="64" MaxHeight="112" MaxLength="8000"
                                 AutomationProperties.Name="Chat prompt" />
                        <!-- Keep actions on a separate row from progress for narrower windows and text scaling. -->
                        <Grid Grid.Row="1" RowSpacing="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                                <Button x:Name="SendButton" Content="Send" IsEnabled="False"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Click="SendButton_Click">
                                    <Button.KeyboardAccelerators>
                                        <KeyboardAccelerator Key="Enter" Modifiers="Control" />
                                    </Button.KeyboardAccelerators>
                                </Button>
                                <Button x:Name="CancelButton" Content="Stop response"
                                        IsEnabled="False" Click="CancelButton_Click" />
                                <Button x:Name="CopyLastReplyButton" Content="Copy reply"
                                        IsEnabled="False" Click="CopyLastReplyButton_Click"
                                        AutomationProperties.Name="Copy last completed assistant reply" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                                <ProgressRing x:Name="ChatProgress" IsActive="False"
                                              Width="20" Height="20" />
                                <TextBlock Text="Ctrl+Enter to send" VerticalAlignment="Center"
                                           FontSize="12" Opacity="0.6" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
