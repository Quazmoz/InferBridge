<?xml version="1.0" encoding="utf-8"?>
<!--
  Microsoft Store (MSIX) manifest. The application is the native WinUI client under
  native\; it starts the bundled PyInstaller engine (InferBridge.exe) beside it.
  scripts/msix_package.py fills the double-brace tokens; Identity Name, Publisher, and
  PublisherDisplayName must match Partner Center > Product identity exactly.

  Store data is placed outside MSIX-virtualized AppData without restricted capabilities.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">

  <Identity Name="{{IDENTITY_NAME}}" Publisher="{{PUBLISHER}}" Version="{{VERSION}}" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>InferBridge</DisplayName>
    <PublisherDisplayName>{{PUBLISHER_DISPLAY_NAME}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="InferBridge" Executable="native\InferBridge.Native.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="InferBridge"
        Description="Local OpenAI-compatible AI server powered by OpenVINO for Intel CPU, GPU, and NPU."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- Off by default; users turn it on in Settings > Apps > Startup. It starts the
             engine and tray, which open the native window. -->
        <desktop:Extension Category="windows.startupTask" Executable="InferBridge.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="InferBridgeStartup" Enabled="false" DisplayName="InferBridge" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
