<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration, slug "launcher". Paste into SignPath > Project >
  Artifact configurations. The GitHub artifact is the bare PyInstaller launcher, zipped by
  actions/upload-artifact. Metadata restrictions are required by SignPath Foundation.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="InferBridge.exe" product-name="InferBridge" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
